    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
