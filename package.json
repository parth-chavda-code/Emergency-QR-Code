  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test",
    "build": "npm run build:frontend",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "test:frontend": "npm --prefix frontend test",
    "db:start": "mongod --replSet emergencyQrDev --dbpath \"$HOME/.local/share/emergency-qr-mongo\" --port 27018 --bind_ip 127.0.0.1 --nounixsocket",
    "staging:seed": "node scripts/seed-staging.js"
  },
