dbconnection=mongodb://127.0.0.1:27017/emergency_qr
PORT=3000
NODE_ENV=development
# Keep 0 locally. Set 1 only behind a verified trusted upstream proxy (Render).
TRUST_PROXY_HOPS=0
# Origin printed in QR links. Use a stable HTTPS domain for production.
PUBLIC_BASE_URL=http://localhost:3000
# Generate a private value as explained in README.md; never reuse an example secret.
JWT_SECRET=
# Separate random 32-byte key, encoded as 64 hexadecimal characters. Keep it safe.
PROFILE_ENCRYPTION_KEY=
